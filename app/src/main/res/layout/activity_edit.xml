<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/ritmoWindowBackground"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp">

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:scaleType="center"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:id="@+id/screen_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/new_title"
            android:textColor="?attr/ritmoTextPrimary"
            android:textSize="19sp"
            android:textStyle="bold" />

        <!-- Ненавязчивый статус автосохранения при редактировании. -->
        <TextView
            android:id="@+id/autosave_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="?attr/ritmoTextSecondary"
            android:textSize="13sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">

            <TextView
                style="@style/Widget.Ritmo.SectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/field_title" />

            <EditText
                android:id="@+id/title_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/field_background"
                android:hint="@string/title_hint"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLength="120"
                android:minHeight="50dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="?attr/ritmoTextPrimary"
                android:textColorHint="?attr/ritmoTextSecondary"
                android:textSize="16sp"
                android:selectAllOnFocus="true" />

            <TextView
                style="@style/Widget.Ritmo.SectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/repeat_label" />

            <Spinner
                android:id="@+id/repeat_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/field_background_select"
                android:minHeight="50dp"
                android:paddingStart="14dp"
                android:paddingEnd="38dp" />

            <!-- Однократно и «каждые N дней»: дата и время начала. -->
            <LinearLayout
                android:id="@+id/date_time_block"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/date_time_label"
                    style="@style/Widget.Ritmo.SectionLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/date_time_label" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/date_button"
                        style="@style/Widget.Ritmo.Button.Pill"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <Button
                        android:id="@+id/time_button"
                        style="@style/Widget.Ritmo.Button.Pill"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>

            <!-- Ежедневно, еженедельно, ежемесячно: только время. -->
            <LinearLayout
                android:id="@+id/time_block"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.Ritmo.SectionLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/time_label" />

                <Button
                    android:id="@+id/time_button_only"
                    style="@style/Widget.Ritmo.Button.Pill"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- Еженедельно: дни недели. -->
            <LinearLayout
                android:id="@+id/weekly_block"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.Ritmo.SectionLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/week_days_label" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/week_day_0"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/segment_background"
                        android:button="@null"
                        android:gravity="center"
                        android:minHeight="42dp"
                        android:text="@string/week_day_mon"
                        android:textColor="@color/chip_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <CheckBox
                        android:id="@+id/week_day_1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/segment_background"
                        android:button="@null"
                        android:gravity="center"
                        android:minHeight="42dp"
                        android:text="@string/week_day_tue"
                        android:textColor="@color/chip_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <CheckBox
                        android:id="@+id/week_day_2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/segment_background"
                        android:button="@null"
                        android:gravity="center"
                        android:minHeight="42dp"
                        android:text="@string/week_day_wed"
                        android:textColor="@color/chip_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <CheckBox
                        android:id="@+id/week_day_3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/segment_background"
                        android:button="@null"
                        android:gravity="center"
                        android:minHeight="42dp"
                        android:text="@string/week_day_thu"
                        android:textColor="@color/chip_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/week_day_4"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/segment_background"
                        android:button="@null"
                        android:gravity="center"
                        android:minHeight="42dp"
                        android:text="@string/week_day_fri"
                        android:textColor="@color/chip_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <CheckBox
                        android:id="@+id/week_day_5"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/segment_background"
                        android:button="@null"
                        android:gravity="center"
                        android:minHeight="42dp"
                        android:text="@string/week_day_sat"
                        android:textColor="@color/chip_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <CheckBox
                        android:id="@+id/week_day_6"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/segment_background"
                        android:button="@null"
                        android:gravity="center"
                        android:minHeight="42dp"
                        android:text="@string/week_day_sun"
                        android:textColor="@color/chip_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>

            <!-- Ежемесячно: день месяца. -->
            <LinearLayout
                android:id="@+id/monthly_block"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.Ritmo.SectionLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/monthly_day_label" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/month_day_input"
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/field_background"
                        android:gravity="center"
                        android:hint="@string/month_day_hint"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="2"
                        android:minHeight="44dp"
                        android:textColor="?attr/ritmoTextPrimary"
                        android:textColorHint="?attr/ritmoTextSecondary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:selectAllOnFocus="true" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/month_day_suffix"
                        android:textColor="?attr/ritmoTextSecondary"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Ежегодно: месяц и день. -->
            <LinearLayout
                android:id="@+id/yearly_block"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.Ritmo.SectionLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/yearly_date_label" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Spinner
                        android:id="@+id/year_month_spinner"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/field_background_select"
                        android:minHeight="44dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="38dp" />

                    <EditText
                        android:id="@+id/year_day_input"
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/field_background"
                        android:gravity="center"
                        android:hint="@string/yearly_day_hint"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="2"
                        android:minHeight="44dp"
                        android:textColor="?attr/ritmoTextPrimary"
                        android:textColorHint="?attr/ritmoTextSecondary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:selectAllOnFocus="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/yearly_day_suffix"
                        android:textColor="?attr/ritmoTextSecondary"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Через интервалы: шаг и необязательное окно. -->
            <LinearLayout
                android:id="@+id/interval_block"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.Ritmo.SectionLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/interval_label" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/interval_input"
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/field_background"
                        android:gravity="center"
                        android:hint="@string/interval_hint"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="3"
                        android:minHeight="44dp"
                        android:textColor="?attr/ritmoTextPrimary"
                        android:textColorHint="?attr/ritmoTextSecondary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:selectAllOnFocus="true" />

                    <RadioGroup
                        android:id="@+id/interval_unit_group"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/interval_unit_minutes"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/segment_background"
                            android:button="@null"
                            android:gravity="center"
                            android:minHeight="44dp"
                            android:text="@string/interval_unit_minutes"
                            android:textColor="@color/chip_text"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <RadioButton
                            android:id="@+id/interval_unit_hours"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/segment_background"
                            android:button="@null"
                            android:gravity="center"
                            android:minHeight="44dp"
                            android:text="@string/interval_unit_hours"
                            android:textColor="@color/chip_text"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </RadioGroup>
                </LinearLayout>

                <Switch
                    android:id="@+id/window_switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="48dp"
                    android:text="@string/window_limit"
                    android:textColor="?attr/ritmoTextPrimary"
                    android:textSize="15sp"
                    android:thumb="@drawable/switch_thumb"
                    android:track="@drawable/switch_track" />

                <LinearLayout
                    android:id="@+id/window_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/window_start_button"
                        style="@style/Widget.Ritmo.Button.Pill"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <Button
                        android:id="@+id/window_end_button"
                        style="@style/Widget.Ritmo.Button.Pill"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>

            <!-- Каждые N дней: шаг в днях. -->
            <LinearLayout
                android:id="@+id/every_n_block"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.Ritmo.SectionLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/every_n_days_label" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/every_days_input"
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/field_background"
                        android:gravity="center"
                        android:hint="@string/every_n_days_hint"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="2"
                        android:minHeight="44dp"
                        android:textColor="?attr/ritmoTextPrimary"
                        android:textColorHint="?attr/ritmoTextSecondary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:selectAllOnFocus="true" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/every_n_days_suffix"
                        android:textColor="?attr/ritmoTextSecondary"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="?attr/ritmoTextSecondary"
                android:textSize="13sp" />

        </LinearLayout>
    </ScrollView>

    <!-- Нижняя зона для большого пальца: результат расчёта, пресеты и сохранение. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/schedule_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="?attr/ritmoTextSecondary"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/presets_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Widget.Ritmo.SectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/quick_pick" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/preset_15_min"
                    style="@style/Widget.Ritmo.Button.Preset"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/preset_15_min" />

                <Button
                    android:id="@+id/preset_1_hour"
                    style="@style/Widget.Ritmo.Button.Preset"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/preset_1_hour" />

                <Button
                    android:id="@+id/preset_tomorrow"
                    style="@style/Widget.Ritmo.Button.Preset"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/preset_tomorrow" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/save_button"
            style="@style/Widget.Ritmo.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/save" />

    </LinearLayout>
</LinearLayout>
