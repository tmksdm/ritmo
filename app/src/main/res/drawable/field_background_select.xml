<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Поле выбора: та же подложка, что у полей ввода, плюс указатель справа. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/ritmoField" />
            <stroke
                android:width="1dp"
                android:color="?attr/ritmoCardStroke" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item
        android:width="24dp"
        android:height="24dp"
        android:drawable="@drawable/ic_chevron_right"
        android:gravity="end|center_vertical"
        android:right="14dp" />
</layer-list>
