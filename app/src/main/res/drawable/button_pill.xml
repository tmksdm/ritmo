<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Пилюля с рамкой: дата, время, границы окна интервала. -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/ritmoChipPressed" />
            <stroke
                android:width="1dp"
                android:color="?attr/ritmoCardStroke" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/ritmoChip" />
            <stroke
                android:width="1dp"
                android:color="?attr/ritmoCardStroke" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
