<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Трек переключателя: включённый — акцент, выключенный — нейтральный. -->
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/ritmoAccent" />
            <corners android:radius="14dp" />
            <size
                android:width="46dp"
                android:height="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/ritmoSwitchTrackOff" />
            <corners android:radius="14dp" />
            <size
                android:width="46dp"
                android:height="28dp" />
        </shape>
    </item>
</selector>
