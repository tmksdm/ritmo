<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Плоские кнопки: без тени и подъёма (stateListAnimator и elevation сброшены),
      со скруглением, рамкой и понятным состоянием нажатия.
    -->
    <style name="Widget.Ritmo.Button" parent="@android:style/Widget.DeviceDefault.Button">
        <item name="android:background">@drawable/button_flat</item>
        <item name="android:textColor">?attr/ritmoTextPrimary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Ritmo.Button.Primary">
        <item name="android:background">@drawable/button_primary</item>
        <item name="android:textColor">@color/button_primary_text</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">56dp</item>
    </style>
</resources>
