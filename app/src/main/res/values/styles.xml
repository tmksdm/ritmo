<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Подписи разделов и полей: мелкие, приглушённые, в верхнем регистре. -->
    <style name="Widget.Ritmo.SectionLabel" parent="">
        <item name="android:textColor">?attr/ritmoTextSecondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.09</item>
    </style>

    <!--
      Базовые кнопки: плоские, без тени и подъёма (stateListAnimator и elevation
      сброшены), со скруглением 12dp. Это чип: мягкая подложка без рамки.
    -->
    <style name="Widget.Ritmo.Button" parent="@android:style/Widget.DeviceDefault.Button">
        <item name="android:background">@drawable/button_flat</item>
        <item name="android:textColor">?attr/ritmoTextPrimary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Пресет времени: две строки текста, заметная высота. -->
    <style name="Widget.Ritmo.Button.Preset">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:maxLines">2</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>

    <!-- Пилюля с рамкой: дата, время, границы окна. -->
    <style name="Widget.Ritmo.Button.Pill">
        <item name="android:background">@drawable/button_pill</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
    </style>

    <!-- Основное действие: акцентная заливка. -->
    <style name="Widget.Ritmo.Button.Primary">
        <item name="android:background">@drawable/button_primary</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">52dp</item>
    </style>
</resources>
